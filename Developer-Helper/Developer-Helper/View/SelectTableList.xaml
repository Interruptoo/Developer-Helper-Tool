<UserControl x:Class="Developer_Helper.View.SelectTableList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Developer_Helper.View"
             xmlns:uc="clr-namespace:Developer_Helper.UC"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1600" Background="#FFF0F0F0">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resource/CommonStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="Tab_Header">
                <StackPanel Orientation="Horizontal">
                    <!--<Image Width="16" Height="16" Source="/DH;component/Images/16/action_refresh.gif" Stretch="Fill" />-->
                    <TextBlock Text="{Binding}" Margin="0" VerticalAlignment="Center" FontWeight="Normal" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="2.5*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>
        <!--row 0-->
        <StackPanel Orientation="Horizontal">
            <!--<TextBox Height="20" Width="150" Margin="5,0,0,0" />-->
            <uc:DHTextBox x:Name="txtKeyword" Height="20" MinWidth="160" Margin="5,2,0,0" ClearButtonVisibility="Visible" Watermark="키워드1, 키워드2" VerticalContentAlignment="Center" />
            <!--<TextBlock Text="키워드1, 키워드2 (AND 조건)" VerticalAlignment="Center" Margin="5,0,0,0"/>-->
            <ComboBox x:Name="cboAndOr" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Width="55" Height="20" Margin="0,1,0,0" SelectedIndex="0" SelectedValuePath="Content">
                <ComboBoxItem Content="AND" IsSelected="True"/>
                <ComboBoxItem Content="OR"/>
            </ComboBox>

            <CheckBox x:Name="chkRealTime" Content="실시간검색" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" IsChecked="True" />
            <CheckBox x:Name="chkOwnerFilter" Content="Owner필터" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" IsChecked="False" >
                <CheckBox.Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="IsEnabled" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=SelectedIndex, ElementName=tabMain}" Value="1">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </CheckBox.Style>
            </CheckBox>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
            <!--<TextBox Height="20" Width="150" Margin="5,0,0,0"/>-->
            <uc:DHTextBox x:Name="txtKeywordCol" Height="20" MinWidth="160" Margin="5,2,0,0" ClearButtonVisibility="Visible" Watermark="키워드1, 키워드2" />
            <ComboBox x:Name="cboAndOrCol" Grid.Column="1" HorizontalAlignment="Left" Margin="0,1,0,0" VerticalAlignment="Center" Width="55" Height="20" SelectedIndex="0" SelectedValuePath="Content">
                <ComboBoxItem Content="AND" IsSelected="True"/>
                <ComboBoxItem Content="OR"/>
            </ComboBox>
        </StackPanel>
        <DockPanel Grid.Column="4" LastChildFill="False">
            <!--<TextBox Height="20" Width="150" Margin="5,0,0,0" DockPanel.Dock="Left" />-->
            <uc:DHTextBox x:Name="txtKeywordObj" Height="20" MinWidth="160" Margin="5,2,0,0" ClearButtonVisibility="Visible" Watermark="키워드1, 키워드2" />
            <ComboBox x:Name="cboAndOrObj" Grid.Column="1" HorizontalAlignment="Left" Margin="0,1,0,0"  Width="55" Height="20" VerticalAlignment="Center" SelectedIndex="0" SelectedValuePath="Content">
                <ComboBoxItem Content="AND" IsSelected="True"/>
                <ComboBoxItem Content="OR"/>
            </ComboBox>
            
            <Button x:Name="BtnSelect" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Grid.Column="4" Height="25" Width="64">
                <StackPanel Orientation="Horizontal">
                    <Image Width="21" Height="21" Source="/Developer-Helper;component/Image/Icon/Find.png" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="5,0,0,0" />
                    <TextBlock Text="조회" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" TextWrapping="WrapWithOverflow" Margin="5, 0, 5, 0" />
                </StackPanel>
            </Button>
        </DockPanel>

        <!--row 1 col 0-->
        <Grid Grid.Row="1" Background="#F0F0F0">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="0.5*"/>
            </Grid.RowDefinitions>
            <TabControl x:Name="tabMain" HorizontalAlignment="Stretch" Margin="0,-2,0,0" VerticalAlignment="Stretch" BorderBrush="#696969" BorderThickness="0,1,0,0" SelectedIndex="0">
                <TabItem Header="전체" HeaderTemplate="{StaticResource Tab_Header}" Style="{StaticResource TabItemDepth2}">
                    <DataGrid Margin="0,5,5,5" 
                              x:Name="dgdObjList" 
                              AutoGenerateColumns="False" 
                              HorizontalAlignment="Stretch" 
                              VerticalAlignment="Stretch" 

          
                              AllowDrop="True" 
                              CanUserAddRows="False"
          
                              ScrollViewer.CanContentScroll="True"    
         
                              EnableColumnVirtualization="True" 
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                              VirtualizingPanel.VirtualizationMode="Standard"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              MaxHeight="1500"
                              HorizontalGridLinesBrush="#FFD5D5D5" VerticalGridLinesBrush="#FFD5D5D5"  >
                        <DataGrid.ContextMenu>
                            <ContextMenu >

                                <MenuItem >
                                    <MenuItem.Icon>
                                        <Image Source="/DH;component/Images/Icon/icon_wand.gif" />
                                    </MenuItem.Icon>
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Label Content="즐겨찾기 추가" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem >
                                    <MenuItem.Icon>
                                        <Image Source="/DH;component/Images/Icon/icon_wand.gif" />
                                    </MenuItem.Icon>
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Label Content="DDL Create" />
                                            <!--<uc:DHTextBox Width="30" Name="tbInsertAlias" Margin="2,0,0,0" Height="20" />
                <Label Content="Alias" />-->
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>

                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding OWNER}" Header="OWNER" Width="50" />
                            <DataGridTextColumn Binding="{Binding TABLE_NAME}" Header="TABLE" Width="80" FontWeight="Bold" />
                            <DataGridTextColumn Binding="{Binding TABLE_COMMENTS}" Header="TABLE COMMENTS" Width="*" FontSize="10" />
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Height="16" Width="16"
                Background="Transparent" BorderBrush="Transparent" BorderThickness="0" ToolTip="SELECT 쿼리를 복사합니다." >
                                            <StackPanel Orientation="Horizontal">
                                                <Image Width="16" Height="16" Source="/DH;component/Images/Icon/My-Documents-Inside-Green-128.png"  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Height="16" Width="16"
                Background="Transparent" BorderBrush="Transparent" BorderThickness="0" ToolTip="SELECT 쿼리를 복사합니다. (매개변수 포함)" >
                                            <StackPanel Orientation="Horizontal">
                                                <Image Width="16" Height="16" Source="/DH;component/Images/Icon/My-Documents-Inside-Green-128.png" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Height="16" Width="16"
                Background="Transparent" BorderBrush="Transparent" BorderThickness="0" ToolTip="데이터를 조회합니다." >
                                            <StackPanel Orientation="Horizontal">
                                                <Image Width="14" Height="16" Source="/DH;component/Images/Icon/edit-redo.png" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Binding="{Binding CREATED_DAYS}" Header="CREATED_DAYS" Visibility="Collapsed" Width="30" />
                            <DataGridTextColumn Binding="{Binding MODIFY_DAYS}" Header="MODIFY_DAYS" Visibility="Collapsed" Width="30" CellStyle="{StaticResource CellStyleCenter}" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">

                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </TabItem>
                <TabItem x:Name="grdFav" Header="즐겨찾기" HeaderTemplate="{StaticResource Tab_Header}" Style="{StaticResource TabItemDepth2}">
                    <DataGrid Margin="0,5,5,5" 
                              x:Name="dgdFavObjList" 
                              AutoGenerateColumns="False" 
                              HorizontalAlignment="Stretch" 
                              VerticalAlignment="Stretch" 
      
                              AllowDrop="True" 
                              CanUserAddRows="False"
      
                              ScrollViewer.CanContentScroll="True"    
     
                              EnableColumnVirtualization="True" 
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                              VirtualizingPanel.VirtualizationMode="Standard"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              MaxHeight="1500"
                              HorizontalGridLinesBrush="#FFD5D5D5" VerticalGridLinesBrush="#FFD5D5D5"  >
                        <DataGrid.ContextMenu>
                            <ContextMenu >

                                <MenuItem >
                                    <MenuItem.Icon>
                                        <Image Source="/DH;component/Images/Icon/icon_wand.gif" />
                                    </MenuItem.Icon>
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Label Content="DDL Create" />
                                            <!--<uc:DHTextBox Width="30" Name="tbInsertAlias" Margin="2,0,0,0" Height="20" />
            <Label Content="Alias" />-->
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>


                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding OWNER}" Header="OWNER" Width="50" />
                            <DataGridTextColumn Binding="{Binding TABLE_NAME}" Header="TABLE" Width="80" FontWeight="Bold" />
                            <DataGridTextColumn Binding="{Binding TABLE_COMMENTS}" Header="TABLE COMMENTS" Width="*" FontSize="10" />
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Height="16" Width="16"
            Background="Transparent" BorderBrush="Transparent" BorderThickness="0" ToolTip="SELECT 쿼리를 복사합니다." >
                                            <StackPanel Orientation="Horizontal">
                                                <Image Width="16" Height="16" Source="/DH;component/Images/Icon/My-Documents-Inside-Green-128.png"  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Height="16" Width="16"
            Background="Transparent" BorderBrush="Transparent" BorderThickness="0" ToolTip="SELECT 쿼리를 복사합니다. (매개변수 포함)" >
                                            <StackPanel Orientation="Horizontal">
                                                <Image Width="16" Height="16" Source="/DH;component/Images/Icon/My-Documents-Inside-Green-128.png" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Height="16" Width="16"
            Background="Transparent" BorderBrush="Transparent" BorderThickness="0" ToolTip="데이터를 조회합니다." >
                                            <StackPanel Orientation="Horizontal">
                                                <Image Width="14" Height="16" Source="/DH;component/Images/Icon/edit-redo.png" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Binding="{Binding CREATED_DAYS}" Header="CREATED_DAYS" Visibility="Collapsed" Width="30" />
                            <DataGridTextColumn Binding="{Binding MODIFY_DAYS}" Header="MODIFY_DAYS" Visibility="Collapsed" Width="30" CellStyle="{StaticResource CellStyleCenter}" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">

                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </TabItem>
            </TabControl>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="100">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=SelectedIndex, ElementName=tabMain}" Value="1">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>


                <Button x:Name="BtnUp" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="2" Height="20" Width="20" Margin="2,0,0,0" >
                    <StackPanel Orientation="Horizontal">
                        <Image Width="14" Height="14" Source="/Developer-Helper;component/Image/Icon/arrow2_n.gif"  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0" />

                        <TextBlock Text="" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" TextWrapping="WrapWithOverflow" Margin="5, 0, 5, 0" />

                    </StackPanel>
                </Button>
                <Button x:Name="BtnDown" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="2" Height="20" Width="20" Margin="2,0,0,0" >
                    <StackPanel Orientation="Horizontal">
                        <Image Width="14" Height="14" Source="/Developer-Helper;component/Image/Icon/arrow2_s.gif" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0" />

                        <TextBlock Text="" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" TextWrapping="WrapWithOverflow" Margin="5, 0, 5, 0" />

                    </StackPanel>
                </Button>
                <Button x:Name="BtnDelete" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="2" Height="20" Width="20" Margin="2,0,0,0" >
                    <StackPanel Orientation="Horizontal">
                        <Image Width="14" Height="14" Source="/Developer-Helper;component/Image/Icon/subtract.gif" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0" />

                        <TextBlock Text="" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" TextWrapping="WrapWithOverflow" Margin="5, 0, 5, 0" />

                    </StackPanel>
                </Button>
                <Button x:Name="BtnSave" ToolTip="저장합니다." HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="2" Height="20" Width="20" Margin="2,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="14" Height="14" Source="/Developer-Helper;component/Image/Icon/document-save16.png" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0" />

                        <TextBlock Text="" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" TextWrapping="WrapWithOverflow" Margin="5, 0, 5, 0" />

                    </StackPanel>
                </Button>

                <Button x:Name="BtnReload" ToolTip="새로고침" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Grid.Column="2" Height="20" Width="20" >
                    <StackPanel Orientation="Horizontal">
                        <Image Width="14" Height="14" Source="/Developer-Helper;component/Image/Icon/reload.gif" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0" />

                        <TextBlock Text="" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" TextWrapping="WrapWithOverflow" Margin="5, 0, 5, 0" />

                    </StackPanel>
                </Button>
            </StackPanel>

            <GridSplitter Grid.Row="1" Width="Auto" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            <DataGrid Grid.Row="2" Margin="5,0,5,5" VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="INDEX NAME" Width="100">

                    </DataGridTextColumn>
                    <DataGridTextColumn Header="COLUMN" Width="100">

                    </DataGridTextColumn>
                    <DataGridTextColumn Header="COMMENT" Width="*">

                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="3" Width="Auto" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            <DataGrid Grid.Row="4" Margin="5,0,5,5" VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="STATUS" Width="100">

                    </DataGridTextColumn>
                    <DataGridTextColumn Header="VALUE" Width="*">

                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <!--row 1 col 1-->
        <GridSplitter Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Width="5"/>
        <!--row 1 col 2-->
        <Grid Grid.Row="1" Grid.Column="2" Background="#F0F0F0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="5" />
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DataGrid Margin="5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="COLUMN" Width="100">
                        
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="NULL" Width="40">

                    </DataGridTextColumn>
                    <DataGridTextColumn Header="DATA TYPE" Width="80">

                    </DataGridTextColumn>
                    <DataGridTextColumn Header="COMMENT" Width="*">

                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" Width="Auto" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            <DataGrid Grid.Row="2" Margin="5,0,5,5" AutoGenerateColumns="False" HorizontalAlignment="Stretch">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding COMN_GRP_CD}" Header="COMN_GRP_CD" Width="90" />
                    <DataGridTextColumn Binding="{Binding COMN_CD}" Header="COMN_CD" Width="80" />
                    <DataGridTextColumn Binding="{Binding COMN_CD_NM}" Header="COMN_CD_NM" Width="200"  />
                    <DataGridTextColumn Binding="{Binding COMN_CD_EXPL}" Header="COMN_CD_EXPL" Width="200" />
                    <DataGridTextColumn Binding="{Binding SCRN_MRK_SEQ}" Header="SORT" Width="50" />
                    <DataGridTextColumn Binding="{Binding USE_YN}" Header="USE_YN" Width="50" />

                    <DataGridTextColumn Binding="{Binding DTRL1_NM}" Header="DTRL1_NM" Width="120" />
                    <DataGridTextColumn Binding="{Binding DTRL2_NM}" Header="DTRL2_NM" Width="120" />
                    <DataGridTextColumn Binding="{Binding DTRL3_NM}" Header="DTRL3_NM" Width="120" />
                    <DataGridTextColumn Binding="{Binding DTRL4_NM}" Header="DTRL4_NM" Width="120" />
                    <DataGridTextColumn Binding="{Binding DTRL5_NM}" Header="DTRL5_NM" Width="120" />
                    <DataGridTextColumn Binding="{Binding DTRL6_NM}" Header="DTRL6_NM" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <!--row 1 col 3-->
        <GridSplitter Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Width="5"/>
        <!--row 1 col 4-->
        <Grid Grid.Row="1" Grid.Column="4" Background="#F0F0F0">
            <DataGrid Margin="5">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding OWNER}" Header="OWNER" Width="50" />
                    <DataGridTextColumn Binding="{Binding OBJ_NAME}" Header="OBJ NAME" Width="*"  />
                    <DataGridTextColumn Binding="{Binding OBJ_TYPE}" Header="OBJ TYPE" Width="80" FontSize="10" />
                    <DataGridTextColumn Binding="{Binding STATUS}" Header="STATUS" Width="50" FontSize="10" />
                    <!--<DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="BtnOpenPLEdit_Click" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Height="16" Width="16"
                                        Background="Transparent" BorderBrush="Transparent" BorderThickness="0" ToolTip="PLEdit로 소스코드를 조회합니다." >
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="14" Height="16" Source="/DH;component/Images/Icon/edit-redo.png" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>-->
                    <DataGridTemplateColumn Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Height="17" Width="40"
                                        BorderThickness="0" Tag="PLEdit"
                                        ToolTip="PLEdit으로 소스코드를 조회합니다." >
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="LightGreen" Width="5" Height="auto" BorderThickness="1" BorderBrush="LightSeaGreen" VerticalAlignment="Stretch" Margin="0,0,0,0" />
                                        <TextBlock Text="PLEdit" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Margin="2, 0, 5, 0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
    
</UserControl>
